# =========================================================================
# FINDCO — environment configuration (Cloudflare-only backend)
# Copy to .env.local for local development. Never commit .env.local.
# =========================================================================

# --- Public (build-time, safe to expose in the browser) ---
# Razorpay PUBLIC Key ID only (Dashboard -> Settings -> API Keys). Test: rzp_test_...
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Backend mode: leave unset (Cloudflare API) or set to "local" for offline demo UI.
# VITE_BACKEND_MODE=local

VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0

# --- Server-only secrets — set these ONLY in the Cloudflare Pages dashboard ---
# --- (Settings -> Environment variables, encrypted), NEVER with real values here, ---
# --- and NEVER prefix them with VITE_ (VITE_ vars are shipped to the browser). ---
# RAZORPAY_KEY_ID=rzp_test_...            # same key id, used server-side for Orders API basic auth
# RAZORPAY_KEY_SECRET=                     # secret — used in create-order / verify (HMAC)
# RAZORPAY_WEBHOOK_SECRET=                 # secret — used to verify webhook signatures
# GOOGLE_CLIENT_ID=                        # enables Google sign-in (/api/auth/google/*)
# GOOGLE_CLIENT_SECRET=                    # secret
# RESEND_API_KEY=                          # optional — enables email OTP delivery
# OTP_FROM_EMAIL=FindCo <onboarding@resend.dev>
# ENVIRONMENT=production                   # production hides dev OTP codes

# Database: no connection string needed — D1 is bound as env.DB via wrangler.toml.
